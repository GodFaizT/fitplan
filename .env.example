# Variáveis para o docker-compose (copia para .env e preenche).
# NUNCA commitar o .env real (está no .gitignore).
# O compose recusa arrancar se POSTGRES_PASSWORD / JWT_* não estiverem definidos.

# Password do PostgreSQL (escolhe uma forte)
POSTGRES_PASSWORD=

# Segredos JWT — gerar aleatórios, mínimo 32 caracteres. Ex.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Origem(ns) permitida(s) no CORS — domínio do frontend (sem barra final)
CORS_ORIGIN=http://localhost:3000

# URL público da API usado pelo frontend em build-time
NEXT_PUBLIC_API_URL=http://localhost:3001/api
