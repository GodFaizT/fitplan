# Variáveis para o docker-compose (copia para .env e preenche).
# NUNCA commitar o .env real (está no .gitignore).
# O compose recusa arrancar se POSTGRES_PASSWORD / JWT_* não estiverem definidos.

# Password do PostgreSQL (escolhe uma forte)
POSTGRES_PASSWORD=

# Segredos JWT — gerar aleatórios, mínimo 32 caracteres. Ex.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email do administrador — esta conta fica admin + aprovada automaticamente.
# As restantes contas ficam pendentes até o admin as aprovar.
ADMIN_EMAIL=

# (Opcional) Análise de refeições por foto com IA via OpenRouter
OPENROUTER_API_KEY=

# Origem(ns) permitida(s) no CORS — domínio do frontend (sem barra final)
CORS_ORIGIN=http://localhost:3000

# URL público da API, lido pelo frontend em runtime
API_URL=http://localhost:3001/api

# (Opcional) Notificações push. Gerar um par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@exemplo.com
