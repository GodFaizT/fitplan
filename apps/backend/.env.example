# Backend (NestJS) — variáveis de ambiente. Copia para .env e preenche.
# NUNCA commitar o .env real (está no .gitignore).

# Ligação à base de dados PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/fitplan?schema=public"

# Segredos JWT — OBRIGATÓRIO gerar valores aleatórios (mínimo 32 caracteres).
# Ex.: openssl rand -hex 32
# A API recusa arrancar se faltarem, forem curtos ou forem valores de exemplo.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Duração dos tokens
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# CORS — domínio do frontend (em produção usar o domínio real, não *)
CORS_ORIGIN="http://localhost:3000"

# Email do administrador — esta conta fica admin + aprovada automaticamente.
# As restantes contas ficam pendentes até o admin as aprovar.
# Usa o teu email real só no .env (NUNCA aqui no exemplo versionado) e regista
# essa conta logo após o primeiro deploy para ninguém a poder reclamar.
ADMIN_EMAIL="admin@exemplo.com"

# Porta da API
PORT="3001"

# Define como "true" para usar cookie httpOnly no refresh token (recomendado)
USE_REFRESH_COOKIE="true"

# Web Push (VAPID) — opcional, para notificações. Sem isto, o push fica desligado.
# Gerar um par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@exemplo.com"

# Cookie Secure exige HTTPS. Com domínio/HTTPS deixa a "true".
# Para correr sobre http://IP (sem domínio), define "false".
COOKIE_SECURE="true"
