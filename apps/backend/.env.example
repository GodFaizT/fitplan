# Backend (NestJS) — variáveis de ambiente. Copia para .env e preenche.
# NUNCA commitar o .env real (está no .gitignore).

# Ligação à base de dados PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/fitplan?schema=public"

# Segredos JWT (gerar valores longos e aleatórios para produção)
JWT_ACCESS_SECRET="muda-isto-em-producao-access"
JWT_REFRESH_SECRET="muda-isto-em-producao-refresh"

# Duração dos tokens
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# CORS — domínio do frontend (em produção usar o domínio real, não *)
CORS_ORIGIN="http://localhost:3000"

# Porta da API
PORT="3001"

# Define como "true" para usar cookie httpOnly no refresh token (recomendado)
USE_REFRESH_COOKIE="true"

# Cookie Secure exige HTTPS. Com domínio/HTTPS deixa a "true".
# Para correr sobre http://IP (sem domínio), define "false".
COOKIE_SECURE="true"
