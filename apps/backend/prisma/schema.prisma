// Schema Prisma do FitPlan (PROJECT.md secção 3.2).
// Modelo relacional em PostgreSQL. Migrações geridas por `prisma migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?

  // acesso
  role     String  @default("user") // user | admin
  approved Boolean @default(false) // contas novas ficam pendentes até aprovação

  // dados pessoais (calculadora de nutrição)
  sex           String?
  age           Int?
  weightKg      Float?
  heightCm      Float?
  activityLevel String?
  goal          String?
  goalIntensity String?

  // preferências
  units       String  @default("metric")
  accentColor String?
  theme       String  @default("dark")

  // alvos calculados (cache) — PROJECT.md 5.6 (fonte única de verdade)
  targetCalories Int?
  targetProtein  Int?
  targetCarbs    Int?
  targetFat      Int?

  // meta de peso (opcional) — usada para projeção de tendência no Progresso
  targetWeightKg Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedFoods      SavedFood[]
  dailyLogs       DailyLog[]
  weightEntries   WeightEntry[]
  measurements    BodyMeasurement[]
  workoutSessions WorkoutSession[]
  mealTemplates   MealTemplate[]
  planMemberships PlanMember[]
  ownedPlans      WorkoutPlan[] @relation("owner")
  refreshTokens   RefreshToken[]
  pushSubscriptions PushSubscription[]
  progressPhotos  ProgressPhoto[]
  cardioSessions  CardioSession[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model SavedFood {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  per      Float // base de referência, ex: 100
  unit     String // ex: "g"
  calories Float // por `per` `unit`
  protein  Float
  carbs    Float
  fat      Float

  @@index([userId])
}

model DailyLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  water  Int      @default(0) // copos de água do dia
  meals  Meal[]

  @@unique([userId, date])
}

model Meal {
  id         String     @id @default(cuid())
  dailyLogId String
  dailyLog   DailyLog   @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  type       String // pequeno-almoco | almoco | lanche | jantar | ceia | outro
  label      String?
  consumed   Boolean    @default(false)
  position   Int        @default(0)
  items      FoodItem[]

  @@index([dailyLogId])
}

model FoodItem {
  id       String @id @default(cuid())
  mealId   String
  meal     Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name     String
  quantity Float
  unit     String
  calories Float
  protein  Float
  carbs    Float
  fat      Float
  position Int    @default(0)

  @@index([mealId])
}

model WorkoutPlan {
  id        String       @id @default(cuid())
  ownerId   String
  owner     User         @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  isShared  Boolean      @default(false)
  shareCode String?      @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  days      WorkoutDay[]
  members   PlanMember[]

  @@index([ownerId])
}

model PlanMember {
  planId String
  plan   WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String      @default("member") // owner | member

  @@id([planId, userId])
  @@index([userId])
}

model WorkoutDay {
  id            String      @id @default(cuid())
  planId        String
  plan          WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label         String
  title         String?
  position      Int
  scheduledDays Int[]       @default([]) // dias da semana (0=Dom … 6=Sáb)
  exercises     Exercise[]

  @@index([planId])
}

model Exercise {
  id          String     @id @default(cuid())
  dayId       String
  day         WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  libraryId   String? // ref. a ExerciseLibrary, se veio da biblioteca
  name        String
  muscleGroup String?
  sets        Int
  reps        String
  restSeconds Int
  weight      Float?
  videoUrl    String?
  notes       String?
  imageUrls   String[]
  instructions String[]
  position    Int

  @@index([dayId])
}

model ExerciseLibrary {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  namePt           String? // nome traduzido (PT)
  category         String?
  level            String?
  force            String?
  mechanic         String?
  equipment        String?
  primaryMuscles   String[]
  secondaryMuscles String[]
  instructions     String[]
  instructionsPt   String[] // instruções traduzidas (PT)
  imageUrls        String[]

  @@index([name])
}

model FoodLibrary {
  id       String  @id @default(cuid())
  name     String
  category String? // Proteínas | Hidratos | Lacticínios | Fruta | Vegetais | Gorduras | Outros
  per      Float // base de referência (ex: 100)
  unit     String // ex: "g", "ml"
  calories Float // por `per` `unit`
  protein  Float
  carbs    Float
  fat      Float

  @@index([name])
}

model WeightEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  weightKg Float

  @@unique([userId, date])
  @@index([userId])
}

// Medida corporal (cintura, peito, braço…). Um registo por (utilizador, data, tipo).
model BodyMeasurement {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  type   String // waist | chest | arm | hip | thigh | shoulders | calf | neck
  value  Float // em cm

  @@unique([userId, date, type])
  @@index([userId])
}

// Foto de progresso (antes/depois). A imagem é comprimida no cliente e guardada
// como bytes na própria BD — sem armazenamento externo.
model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  note      String?
  mimeType  String
  data      Bytes
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Sessão de treino concluída (histórico). As séries ficam em SetLog.
model WorkoutSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String? // referência ao plano (pode já não existir)
  planName    String?
  dayLabel    String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationSec Int       @default(0)
  notes       String?
  sets        SetLog[]
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Série registada numa sessão de treino.
model SetLog {
  id           String         @id @default(cuid())
  sessionId    String
  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseName String
  muscleGroup  String?
  setNumber    Int
  weight       Float?
  reps         Int?
  position     Int            @default(0)

  @@index([sessionId])
  @@index([exerciseName])
}

// Sessão de cardio / atividade (corrida, bici, caminhada…). Registo simples,
// independente dos planos de força.
model CardioSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  type        String // run | walk | bike | swim | row | elliptical | hike | other
  durationMin Int
  distanceKm  Float?
  calories    Int?
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

// Refeição guardada como modelo, para re-adicionar rapidamente.
model MealTemplate {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     MealTemplateItem[]
  createdAt DateTime           @default(now())

  @@index([userId])
}

model MealTemplateItem {
  id         String       @id @default(cuid())
  templateId String
  template   MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  quantity   Float
  unit       String
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  position   Int          @default(0)

  @@index([templateId])
}
